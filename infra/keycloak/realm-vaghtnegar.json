{
  "realm": "vaghtnegar",
  "enabled": true,
  "displayName": "VaghtNegar",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "roles": {
    "realm": [
      { "name": "Patient", "description": "بیمار" },
      { "name": "Doctor", "description": "پزشک" },
      { "name": "Receptionist", "description": "پذیرش" },
      { "name": "ClinicAdmin", "description": "مدیر کلینیک" },
      { "name": "SuperAdmin", "description": "مدیر کل سامانه" }
    ]
  },
  "clients": [
    {
      "clientId": "vaghtnegar-api",
      "name": "VaghtNegar API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "vaghtnegar-web",
      "name": "VaghtNegar Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://localhost:3000/*",
        "https://localhost:7180/swagger/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://localhost:3000",
        "https://localhost:7180"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##https://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "vaghtnegar-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vaghtnegar-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "vaghtnegar-api-audience",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "vaghtnegar-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vaghtnegar-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
