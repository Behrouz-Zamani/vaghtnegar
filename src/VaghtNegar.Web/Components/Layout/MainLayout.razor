@inherits LayoutComponentBase
<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/">
            <span class="brand-mark"><span></span><span></span><span></span></span>
            <span><strong>وقت‌نگار</strong><small>سامانه هوشمند سلامت</small></span>
        </a>
        <div class="sidebar-caption">فضای کاری</div>
        <NavMenu />
        <div class="sidebar-bottom">
            <div class="support-card">
                <div class="support-icon">✚</div>
                <strong>همراه شما هستیم</strong>
                <p>برای راهنمایی و پشتیبانی با تیم وقت‌نگار در ارتباط باشید.</p>
                <a href="mailto:support@vaghtnegar.local">ارتباط با پشتیبانی</a>
            </div>
            <div class="sidebar-version">VaghtNegar · نسخه ۱.۰</div>
        </div>
    </aside>

    <main class="main-area">
        <header class="topbar">
            <div class="topbar-title">
                <span class="live-dot"></span>
                <span>سامانه مدیریت خدمات درمانی</span>
            </div>
            <div class="topbar-actions">
                <span class="today-label">@PersianDate.Today</span>
                <AuthorizeView>
                    <Authorized Context="auth">
                        <div class="user-chip">
                            <span class="avatar">@Initial(DisplayName(auth.User))</span>
                            <span class="user-name" title="@DisplayName(auth.User)">@DisplayName(auth.User)</span>
                            <a class="logout-link" href="/account/logout" title="خروج">خروج</a>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-primary btn-small" href="/account/login">ورود</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>
        <div class="page-content">
            @Body
        </div>
        <footer class="page-footer">
            <span>© @DateTime.Now.Year وقت‌نگار</span>
            <span>مراقبت بهتر، مدیریت هوشمندتر</span>
        </footer>
    </main>
</div>

@code {
    private static string DisplayName(ClaimsPrincipal user)
    {
        var directName = user.FindFirst("name")?.Value;
        if (!string.IsNullOrWhiteSpace(directName))
            return directName.Trim();

        var givenName = user.FindFirst("given_name")?.Value;
        var familyName = user.FindFirst("family_name")?.Value;
        var fullName = string.Join(" ", new[] { givenName, familyName }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim()));
        if (!string.IsNullOrWhiteSpace(fullName))
            return fullName;

        var preferredName = user.FindFirst("preferred_username")?.Value;
        if (!string.IsNullOrWhiteSpace(preferredName))
            return preferredName.Trim();

        var identityName = user.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(identityName))
            return identityName.Trim();

        var email = user.FindFirst("email")?.Value;
        return !string.IsNullOrWhiteSpace(email) ? email.Trim() : "حساب کاربری";
    }

    private static string Initial(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "ک" : value.Trim()[0].ToString();
}
