@page "/admin/payments"
@attribute [Authorize(Roles = "ClinicAdmin,SuperAdmin")]
@inject VaghtNegarApiClient ApiClient

<PageTitle>بررسی پرداخت‌ها | وقت‌نگار</PageTitle>

<section class="page-heading">
    <span class="eyebrow">مدیریت مالی</span>
    <h1>بررسی رسیدهای پرداخت</h1>
    <p class="page-lead">نوبت فقط پس از تأیید رسید پرداخت قطعی می‌شود. رد رسید باعث آزادشدن زمان رزرو شده خواهد شد.</p>
</section>

@if (!string.IsNullOrWhiteSpace(feedback))
{
    <div class="admin-feedback @(feedbackIsError ? "error" : "success")" role="status">@feedback</div>
}
<section class="panel-card admin-section">
    <div class="panel-heading">
        <div><span class="eyebrow">در انتظار بررسی</span><h2>رسیدهای ارسالی <span class="count-chip">@payments.Count</span></h2></div>
        <button class="btn btn-outline" disabled="@loading" @onclick="LoadAsync">بازخوانی</button>
    </div>
    @if (loading)
    {
        <div class="loading-line"><span></span> در حال دریافت رسیدها...</div>
    }
    else if (error is not null)
    {
        <div class="notice-card" role="alert"><p>@error</p><button class="btn btn-outline" @onclick="LoadAsync">تلاش مجدد</button></div>
    }
    else if (payments.Count == 0)
    {
        <div class="empty-inline">رسید پرداختی در انتظار بررسی وجود ندارد.</div>
    }
    else
    {
        @foreach (var payment in payments)
        {
            <article class="panel-card admin-section">
                <div class="panel-heading">
                    <div>
                        <h3>@payment.PatientName</h3>
                        <p>پزشک: @payment.DoctorName | مبلغ: <strong>@payment.AmountToman.ToString("N0") تومان</strong></p>
                        <small>زمان نوبت: @payment.StartsAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small>
                        <p>شماره پیگیری: <strong>@payment.ReceiptReference</strong></p>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(payment.ReceiptImageBase64) && !string.IsNullOrWhiteSpace(payment.ReceiptContentType))
                {
                    <img alt="تصویر رسید پرداخت" style="max-width:100%;max-height:420px;object-fit:contain" src="@($"data:{payment.ReceiptContentType};base64,{payment.ReceiptImageBase64}")" />
                }
                <label>علت رد (در صورت رد رسید)
                    <input class="admin-input" @bind="rejectionReasons[payment.Id]" maxlength="500" placeholder="مثلاً مبلغ واریزی با مبلغ فاکتور مطابقت ندارد" />
                </label>
                <div class="admin-form-actions">
                    <button class="btn btn-primary" disabled="@savingId.HasValue" @onclick="() => ApproveAsync(payment.Id)">
                        @(savingId == payment.Id ? "در حال ثبت..." : "تأیید پرداخت و قطعی‌کردن نوبت")
                    </button>
                    <button class="btn btn-danger-soft" disabled="@savingId.HasValue" @onclick="() => RejectAsync(payment.Id)">
                        @(savingId == payment.Id ? "در حال ثبت..." : "رد رسید و آزادسازی زمان")
                    </button>
                </div>
            </article>
        }
    }
</section>

@code {
    private List<PendingAppointmentPaymentDto> payments = [];
    private readonly Dictionary<Guid, string> rejectionReasons = [];
    private bool loading = true;
    private bool feedbackIsError;
    private string? feedback;
    private string? error;
    private Guid? savingId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;

        try
        {
            var result = await ApiClient.GetPendingAppointmentPaymentsAsync();
            if (result.Succeeded && result.Data is not null)
            {
                payments = result.Data;
                foreach (var payment in payments)
                    rejectionReasons.TryAdd(payment.Id, "");
            }
            else
            {
                error = result.Error ?? "دریافت رسیدها ناموفق بود.";
            }
        }
        catch (Exception)
        {
            error = "در دریافت رسیدها خطایی رخ داد. اتصال API را بررسی و دوباره تلاش کنید.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ApproveAsync(Guid id)
    {
        if (savingId.HasValue) return;

        savingId = id;
        feedback = null;

        try
        {
            var result = await ApiClient.ApproveAppointmentPaymentAsync(id);
            feedback = result.Message;
            feedbackIsError = !result.Succeeded;

            if (result.Succeeded)
                await LoadAsync();
        }
        catch (Exception)
        {
            feedback = "ثبت تأیید پرداخت با خطا مواجه شد. وضعیت عملیات را بررسی و دوباره تلاش کنید.";
            feedbackIsError = true;
        }
        finally
        {
            savingId = null;
        }
    }

    private async Task RejectAsync(Guid id)
    {
        if (savingId.HasValue) return;

        var reason = rejectionReasons.GetValueOrDefault(id, "");
        if (string.IsNullOrWhiteSpace(reason))
        {
            feedback = "برای رد رسید، علت آن را وارد کنید.";
            feedbackIsError = true;
            return;
        }

        savingId = id;
        feedback = null;

        try
        {
            var result = await ApiClient.RejectAppointmentPaymentAsync(id, reason.Trim());
            feedback = result.Message;
            feedbackIsError = !result.Succeeded;

            if (result.Succeeded)
            {
                rejectionReasons[id] = "";
                await LoadAsync();
            }
        }
        catch (Exception)
        {
            feedback = "ثبت رد رسید با خطا مواجه شد. اتصال API را بررسی کنید؛ در صورت تکرار، ابتدا وضعیت پرداخت را بازخوانی کنید.";
            feedbackIsError = true;
        }
        finally
        {
            savingId = null;
        }
    }
}
