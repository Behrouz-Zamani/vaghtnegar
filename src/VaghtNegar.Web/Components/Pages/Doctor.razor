@page "/doctor"
@attribute [Authorize(Roles = "Doctor")]
@inject VaghtNegarApiClient ApiClient

<PageTitle>پنل پزشک | وقت‌نگار</PageTitle>

<section class="page-heading">
    <span class="eyebrow">فضای کاری پزشک</span>
    <h1>پنل پزشک</h1>
    <p class="page-lead">تعریف برنامه حضور هفتگی و ایجاد ساعت‌های قابل رزرو برای پذیرش و بیماران.</p>
</section>

@if (loading)
{
    <div class="panel-card loading-line"><span></span> در حال دریافت اطلاعات پزشک و برنامه کاری...</div>
}
else if (loadError is not null)
{
    <div class="notice-card doctor-warning" role="alert">
        <strong>دریافت اطلاعات پنل پزشک ناموفق بود.</strong>
        <p>@loadError</p>
        <button class="btn btn-primary" @onclick="LoadAsync">تلاش مجدد</button>
    </div>
}
else if (doctor is null)
{
    <div class="notice-card doctor-warning">
        <strong>حساب پزشک هنوز به پرونده پزشکی متصل نشده است.</strong>
        <p>برای فعال شدن این پنل، مدیر سامانه باید در بخش «مدیریت پزشکان»، شناسه حساب Keycloak این کاربر را به پرونده پزشک متصل کند. بعد از اتصال، از حساب خارج و دوباره وارد شوید.</p>
    </div>
}
else
{
    <div class="doctor-profile-card">
        <div class="doctor-avatar">⚕</div>
        <div><small>پزشک</small><strong>دکتر @doctor.FirstName @doctor.LastName</strong><span>@(doctor.MedicalCode ?? "کد نظام پزشکی ثبت نشده")</span></div>
        <span class="admin-status active">حساب متصل</span>
    </div>

    <section class="panel-card doctor-schedule-section">
        <div class="panel-heading">
            <div><span class="eyebrow">تنظیمات مالی</span><h2>هزینه ویزیت</h2></div>
        </div>
        <p class="doctor-help">مبلغ ویزیت به تومان ثبت می‌شود و هنگام ثبت درخواست نوبت و پرداخت به بیمار نمایش داده خواهد شد.</p>
        <div class="doctor-availability-filter">
            <label>هزینه ویزیت (تومان)
                <input class="admin-input" type="number" min="1" step="1000" @bind="visitFeeToman" />
            </label>
            <button class="btn btn-primary" disabled="@savingVisitFee" @onclick="SaveVisitFeeAsync">
                @(savingVisitFee ? "در حال ذخیره..." : "ذخیره هزینه ویزیت")
            </button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(feedback))
    {
        <div class="admin-feedback @(feedbackIsError ? "error" : "success")" role="status">@feedback</div>
    }

    <section class="panel-card doctor-schedule-section">
        <div class="panel-heading">
            <div><span class="eyebrow">تنظیمات نوبت‌دهی</span><h2>برنامه کاری هفتگی</h2></div>
            <span class="count-chip">@scheduleDays.Values.Count(x => x.IsActive) روز فعال</span>
        </div>
        <p class="doctor-help">این برنامه به‌صورت هفتگی تکرار می‌شود و به یک تاریخ خاص محدود نیست. تاریخ شمسیِ نمایش‌داده‌شده کنار هر روز، نوبت بعدی آن روز در تقویم است. برای هر روز می‌توانید حداکثر چهار بازه کاری (مثلاً صبح و عصر) تعریف کنید. بازه‌های یک روز نباید با هم تداخل داشته باشند.</p>

        <div class="doctor-week-grid">
            @foreach (var day in WeekDays)
            {
                var item = scheduleDays[day.Day];
                <div class="doctor-day-row @(item.IsActive ? "enabled" : "")">
                    <div class="doctor-day-toggle">
                        <label>
                            <input type="checkbox" @bind="item.IsActive" />
                            <strong>@day.Name</strong>
                            <small class="doctor-day-date">نوبت بعدی: @FormatNextOccurrence(day.Day)</small>
                        </label>
                    </div>

                    <div class="doctor-day-ranges">
                        @if (item.IsActive)
                        {
                            @if (item.Ranges.Count == 0)
                            {
                                <div class="empty-inline">هنوز بازه‌ای برای این روز ثبت نشده است.</div>
                            }

                            @foreach (var range in item.Ranges)
                            {
                                <div class="doctor-range-row">
                                    <label class="doctor-time-field">
                                        <span>از ساعت</span>
                                        <input class="admin-input"
                                               type="time"
                                               value="@range.StartTime"
                                               @onchange="e => range.StartTime = e.Value?.ToString() ?? string.Empty" />
                                    </label>
                                    <label class="doctor-time-field">
                                        <span>تا ساعت</span>
                                        <input class="admin-input"
                                               type="time"
                                               value="@range.EndTime"
                                               @onchange="e => range.EndTime = e.Value?.ToString() ?? string.Empty" />
                                    </label>
                                    <label class="doctor-time-field doctor-duration">
                                        <span>مدت ویزیت</span>
                                        <select class="admin-input" @bind="range.SlotDurationMinutes">
                                            <option value="10">۱۰ دقیقه</option>
                                            <option value="15">۱۵ دقیقه</option>
                                            <option value="20">۲۰ دقیقه</option>
                                            <option value="30">۳۰ دقیقه</option>
                                            <option value="45">۴۵ دقیقه</option>
                                            <option value="60">۶۰ دقیقه</option>
                                        </select>
                                    </label>
                                    <button type="button"
                                            class="btn btn-outline doctor-remove-range"
                                            title="حذف این بازه"
                                            @onclick="() => RemoveRange(day.Day, range)">
                                        حذف
                                    </button>
                                </div>
                            }
                            <button type="button"
                                    class="btn btn-outline doctor-add-range"
                                    disabled="@(item.Ranges.Count >= 4)"
                                    @onclick="() => AddRange(day.Day)">
                                + افزودن بازه @(item.Ranges.Count >= 4 ? "(حداکثر ۴ بازه)" : "")
                            </button>
                        }
                        else
                        {
                            <span class="empty-inline">این روز در برنامه کاری پزشک نیست.</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="doctor-schedule-actions">
            <button class="btn btn-primary" disabled="@saving" @onclick="SaveScheduleAsync">
                @(saving ? "در حال ذخیره..." : "ذخیره برنامه کاری")
            </button>
            <button class="btn btn-outline" disabled="@saving" @onclick="LoadAsync">بازخوانی برنامه</button>
        </div>
    </section>

    <section class="panel-card doctor-schedule-section">
        <div class="panel-heading">
            <div><span class="eyebrow">کنترل نوبت‌ها</span><h2>بررسی ساعت‌های آزاد</h2></div>
        </div>
        <div class="doctor-availability-filter">
            <label>تاریخ شمسی
                <input class="admin-input" @bind="jalaliDate" placeholder="۱۴۰۵/۰۹/۰۱" />
            </label>
            <button class="btn btn-outline" disabled="@loadingSlots" @onclick="LoadSlotsAsync">نمایش ساعت‌های آزاد</button>
        </div>
        @if (slotsError is not null)
        {
            <div class="notice-card doctor-warning" role="alert">
                <p>@slotsError</p>
                <button class="btn btn-outline" @onclick="LoadSlotsAsync">تلاش مجدد</button>
            </div>
        }
        @if (slotsLoaded && slotsError is null)
        {
            @if (availableSlots.Count == 0)
            {
                <div class="empty-inline">برای این تاریخ ساعت آزادی وجود ندارد؛ روز هفته و برنامه کاری را بررسی کنید.</div>
            }
            else
            {
                <div class="doctor-slot-list">
                    @foreach (var slot in availableSlots)
                    {
                        <span class="doctor-slot">@slot.StartTime تا @slot.EndTime</span>
                    }
                </div>
            }
        }
    </section>
}

@code {
    private static readonly (int Day, string Name)[] WeekDays =
    [
        (6, "شنبه"), (0, "یکشنبه"), (1, "دوشنبه"), (2, "سه‌شنبه"),
        (3, "چهارشنبه"), (4, "پنجشنبه"), (5, "جمعه")
    ];

    private readonly Dictionary<int, DayScheduleForm> scheduleDays = WeekDays
        .ToDictionary(x => x.Day, _ => new DayScheduleForm());

    private AdminDoctorItem? doctor;
    private List<AvailableSlotItem> availableSlots = [];
    private bool loading = true;
    private bool saving;
    private bool savingVisitFee;
    private long visitFeeToman;
    private bool loadingSlots;
    private bool slotsLoaded;
    private bool feedbackIsError;
    private string? feedback;
    private string? loadError;
    private string? slotsError;
    private string jalaliDate = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        loading = true;
        feedback = null;

        loadError = null;
        var doctorResult = await ApiClient.GetMyDoctorResultAsync();
        doctor = doctorResult.Data;
        if (doctor is not null)
            visitFeeToman = doctor.VisitFeeToman;
        if (!doctorResult.Succeeded && !doctorResult.NotFound)
        {
            loadError = doctorResult.Error ?? "خطای نامشخص هنگام دریافت اطلاعات پزشک.";
            loading = false;
            return;
        }

        if (doctor is not null)
        {
            if (string.IsNullOrWhiteSpace(jalaliDate))
                jalaliDate = TodayJalali();

            var hoursResult = await ApiClient.GetMyWorkingHoursResultAsync();
            if (!hoursResult.Succeeded || hoursResult.Data is null)
            {
                loadError = hoursResult.Error ?? "دریافت برنامه کاری پزشک ناموفق بود.";
                loading = false;
                return;
            }
            var hours = hoursResult.Data;

            foreach (var day in scheduleDays.Values)
            {
                day.IsActive = false;
                day.Ranges.Clear();
            }

            foreach (var group in hours.GroupBy(x => x.DayOfWeek))
            {
                if (!scheduleDays.TryGetValue(group.Key, out var day))
                    continue;

                day.IsActive = true;
                foreach (var hour in group.OrderBy(x => x.StartTime))
                {
                    day.Ranges.Add(new WorkingRangeForm
                    {
                        StartTime = hour.StartTime,
                        EndTime = hour.EndTime,
                        SlotDurationMinutes = hour.SlotDurationMinutes
                    });
                }
            }
        }

        loading = false;
    }

    private void AddRange(int dayOfWeek)
    {
        if (!scheduleDays.TryGetValue(dayOfWeek, out var day) || day.Ranges.Count >= 4)
            return;

        var start = day.Ranges.Count == 0 ? "09:00" : day.Ranges[^1].EndTime;
        var end = "17:00";

        if (TimeOnly.TryParse(start, out var parsedStart) &&
            TimeOnly.TryParse(end, out var parsedEnd) &&
            parsedStart >= parsedEnd)
        {
            start = "13:00";
            end = "17:00";
        }

        day.Ranges.Add(new WorkingRangeForm
        {
            StartTime = start,
            EndTime = end,
            SlotDurationMinutes = 20
        });
    }

    private void RemoveRange(int dayOfWeek, WorkingRangeForm range)
    {
        if (scheduleDays.TryGetValue(dayOfWeek, out var day))
            day.Ranges.Remove(range);
    }

    private async Task SaveScheduleAsync()
    {
        var items = new List<WorkingHourInputItem>();

        foreach (var entry in scheduleDays)
        {
            var day = entry.Value;
            if (!day.IsActive)
                continue;

            var dayName = WeekDays.First(x => x.Day == entry.Key).Name;
            if (day.Ranges.Count == 0)
            {
                ShowFeedback($"برای روز {dayName} حداقل یک بازه کاری تعریف کنید یا آن روز را غیرفعال کنید.", true);
                return;
            }

            if (day.Ranges.Count > 4)
            {
                ShowFeedback($"برای روز {dayName} حداکثر چهار بازه کاری مجاز است.", true);
                return;
            }

            var parsedRanges = new List<(TimeOnly Start, TimeOnly End, int Duration)>();
            foreach (var range in day.Ranges)
            {
                if (!TimeOnly.TryParse(range.StartTime, out var start) ||
                    !TimeOnly.TryParse(range.EndTime, out var end) ||
                    start >= end)
                {
                    ShowFeedback($"ساعت شروع و پایان یکی از بازه‌های روز {dayName} معتبر نیست.", true);
                    return;
                }

                parsedRanges.Add((start, end, range.SlotDurationMinutes));
            }

            var ordered = parsedRanges.OrderBy(x => x.Start).ToArray();
            for (var i = 1; i < ordered.Length; i++)
            {
                if (ordered[i].Start < ordered[i - 1].End)
                {
                    ShowFeedback($"بازه‌های کاری روز {dayName} با هم تداخل دارند.", true);
                    return;
                }
            }

            foreach (var range in ordered)
            {
                items.Add(new WorkingHourInputItem(
                    entry.Key,
                    range.Start.ToString("HH:mm"),
                    range.End.ToString("HH:mm"),
                    range.Duration));
            }
        }

        if (items.Count == 0)
        {
            ShowFeedback("حداقل یک بازه کاری در یکی از روزها تعریف کنید.", true);
            return;
        }

        saving = true;
        var result = await ApiClient.ReplaceMyWorkingHoursAsync(items);
        saving = false;

        if (!result.Succeeded)
        {
            ShowFeedback(result.Message, true);
            return;
        }

        slotsLoaded = false;
        ShowFeedback("برنامه کاری با موفقیت ذخیره شد. تمام بازه‌ها برای نوبت‌دهی فعال شدند.", false);
    }

    private async Task SaveVisitFeeAsync()
    {
        if (visitFeeToman <= 0)
        {
            ShowFeedback("هزینه ویزیت باید بیشتر از صفر باشد.", true);
            return;
        }

        savingVisitFee = true;
        var result = await ApiClient.UpdateMyDoctorVisitFeeAsync(visitFeeToman);
        savingVisitFee = false;

        if (!result.Succeeded)
        {
            ShowFeedback(result.Message, true);
            return;
        }

        if (doctor is not null)
            doctor = doctor with { VisitFeeToman = visitFeeToman };
        ShowFeedback("هزینه ویزیت با موفقیت ذخیره شد.", false);
    }

    private async Task LoadSlotsAsync()
    {
        if (string.IsNullOrWhiteSpace(jalaliDate))
        {
            ShowFeedback("تاریخ شمسی را وارد کنید؛ نمونه: ۱۴۰۵/۰۹/۰۱", true);
            return;
        }

        loadingSlots = true;
        slotsLoaded = false;
        slotsError = null;
        var result = await ApiClient.GetAvailableSlotsResultAsync(doctor!.Id, NormalizeDigits(jalaliDate));
        if (result.Succeeded)
            availableSlots = result.Data ?? [];
        else
        {
            availableSlots = [];
            slotsError = result.Error ?? "دریافت ساعت‌های آزاد ناموفق بود.";
        }
        loadingSlots = false;
        slotsLoaded = true;
    }

    private static string FormatNextOccurrence(int targetDayOfWeek)
    {
        var tehranNow = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, GetTehranZone()).Date;
        var daysUntil = (targetDayOfWeek - (int)tehranNow.DayOfWeek + 7) % 7;
        var nextDate = tehranNow.AddDays(daysUntil);
        var calendar = new System.Globalization.PersianCalendar();
        return $"{calendar.GetYear(nextDate):0000}/{calendar.GetMonth(nextDate):00}/{calendar.GetDayOfMonth(nextDate):00}";
    }

    private static string TodayJalali()
    {
        var tehranNow = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, GetTehranZone()).Date;
        var calendar = new System.Globalization.PersianCalendar();
        return $"{calendar.GetYear(tehranNow):0000}/{calendar.GetMonth(tehranNow):00}/{calendar.GetDayOfMonth(tehranNow):00}";
    }

    private static TimeZoneInfo GetTehranZone()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Tehran"); }
        catch (TimeZoneNotFoundException) { return TimeZoneInfo.FindSystemTimeZoneById("Iran Standard Time"); }
    }

    private void ShowFeedback(string message, bool isError)
    {
        feedback = message;
        feedbackIsError = isError;
    }

    private static string NormalizeDigits(string value) => value
        .Replace("۰", "0").Replace("۱", "1").Replace("۲", "2").Replace("۳", "3")
        .Replace("۴", "4").Replace("۵", "5").Replace("۶", "6").Replace("۷", "7")
        .Replace("۸", "8").Replace("۹", "9")
        .Replace("٠", "0").Replace("١", "1").Replace("٢", "2").Replace("٣", "3")
        .Replace("٤", "4").Replace("٥", "5").Replace("٦", "6").Replace("٧", "7")
        .Replace("٨", "8").Replace("٩", "9");

    private sealed class DayScheduleForm
    {
        public bool IsActive { get; set; }
        public List<WorkingRangeForm> Ranges { get; } = [];
    }

    private sealed class WorkingRangeForm
    {
        public string StartTime { get; set; } = "09:00";
        public string EndTime { get; set; } = "12:00";
        public int SlotDurationMinutes { get; set; } = 20;
    }
}