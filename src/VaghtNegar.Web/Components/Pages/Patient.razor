@page "/patient"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Patient")]
@inject VaghtNegarApiClient ApiClient

<PageTitle>پنل بیمار | وقت‌نگار</PageTitle>

<section class="page-heading">
    <span class="eyebrow">فضای اختصاصی بیمار</span>
    <h1>پنل بیمار</h1>
    <p class="page-lead">پرونده، نوبت‌های ثبت‌شده و دریافت نوبت جدید.</p>
</section>

@if (loading)
{
    <div class="panel-card loading-line"><span></span> در حال دریافت اطلاعات پرونده...</div>
}
else if (profileLoadError is not null)
{
    <div class="notice-card" role="alert">
        <strong>دریافت اطلاعات پرونده ناموفق بود.</strong>
        <p>@profileLoadError</p>
        <button class="btn btn-primary" @onclick="LoadAsync">تلاش مجدد</button>
    </div>
}
else if (profile is null)
{
    <div class="notice-card">
        <strong>پرونده‌ای به حساب کاربری شما متصل نیست.</strong>
        <p>برای مشاهده نوبت‌ها، مدیر یا مسئول پذیرش باید پرونده بیمار را به شناسه کاربری Keycloak شما متصل کند.</p>
    </div>
}
else
{
    <section class="patient-profile-card">
        <div class="patient-avatar">♡</div>
        <div class="patient-profile-info">
            <small>پرونده بیمار</small>
            <strong>@profile.FirstName @profile.LastName</strong>
            <span>@profile.MobileNumber</span>
        </div>
        <div class="patient-profile-meta">
            <small>تاریخ تولد</small>
            <strong>@FormatBirthDate(profile.BirthDate)</strong>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(feedback))
    {
        <div class="admin-feedback @(feedbackIsError ? "error" : "success")" role="status">@feedback</div>
    }

    <section class="panel-card patient-section">
        <div class="panel-heading">
            <div><span class="eyebrow">سوابق درمانی</span><h2>نوبت‌های من <span class="count-chip">@appointments.TotalCount</span></h2></div>
            <button class="btn btn-outline" @onclick="LoadAppointmentsAsync" disabled="@appointmentsLoading">بازخوانی</button>
        </div>
        @if (appointmentsLoading)
        {
            <div class="loading-line"><span></span> در حال دریافت نوبت‌ها...</div>
        }
        else if (appointmentsError is not null)
        {
            <div class="notice-card" role="alert">
                <p>@appointmentsError</p>
                <button class="btn btn-outline" @onclick="LoadAppointmentsAsync">تلاش مجدد</button>
            </div>
        }
        else if (appointments.Items.Count == 0)
        {
            <div class="empty-inline">هنوز نوبتی برای شما ثبت نشده است.</div>
        }
        else
        {
            <div class="patient-appointments">
                @foreach (var item in appointments.Items)
                {
                    <article class="patient-appointment">
                        <div class="patient-appointment-date">
                            <strong>@FormatJalali(item.StartsAtUtc)</strong>
                            <span>@FormatTehran(item.StartsAtUtc)</span>
                        </div>
                        <div class="patient-appointment-main">
                            <strong>دکتر @item.DoctorFullName</strong>
                            <span>@item.PatientNote</span>
                        </div>
                        <div class="patient-appointment-actions">
                            <span class="soft-status @StatusClass(item.Status)">@LocalizeStatus(item.Status)</span>
                            @if (CanCancel(item))
                            {
                                <button class="btn btn-danger-soft btn-small" disabled="@cancellingId.HasValue" @onclick="() => CancelAppointmentAsync(item.Id)">لغو نوبت</button>
                            }
                        </div>
                    </article>
                }
            </div>
            @if (appointments.TotalPages > 1)
            {
                <div class="reception-pagination">
                    <button class="btn btn-outline btn-small" disabled="@(appointments.Page <= 1 || appointmentsLoading)" @onclick="() => ChangePageAsync(appointments.Page - 1)">قبلی</button>
                    <span>صفحه @appointments.Page از @appointments.TotalPages</span>
                    <button class="btn btn-outline btn-small" disabled="@(appointments.Page >= appointments.TotalPages || appointmentsLoading)" @onclick="() => ChangePageAsync(appointments.Page + 1)">بعدی</button>
                </div>
            }
        }
    </section>

    <section class="panel-card patient-section">
        <div class="panel-heading">
            <div><span class="eyebrow">امور مالی</span><h2>درخواست‌ها و پرداخت‌های من</h2></div>
            <button class="btn btn-outline" @onclick="LoadPaymentsAsync">بازخوانی</button>
        </div>
        @if (myPayments.Count == 0)
        {
            <div class="empty-inline">درخواست پرداختی ثبت نشده است.</div>
        }
        else
        {
            <div class="patient-appointments">
                @foreach (var payment in myPayments)
                {
                    <article class="patient-appointment">
                        <div class="patient-appointment-date">
                            <strong>@FormatJalali(payment.StartsAtUtc)</strong>
                            <span>@FormatTehran(payment.StartsAtUtc)</span>
                        </div>
                        <div class="patient-appointment-main">
                            <strong>@payment.AmountToman.ToString("N0") تومان</strong>
                            <span>@PaymentStatusText(payment.Status)</span>
                            @if (!string.IsNullOrWhiteSpace(payment.ReviewNote))
                            {
                                <small>توضیح مدیر: @payment.ReviewNote</small>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="panel-card patient-section">
        <div class="panel-heading">
            <div><span class="eyebrow">نوبت‌دهی آنلاین</span><h2>دریافت نوبت جدید</h2></div>
        </div>
        @if (doctorsError is not null)
        {
            <div class="notice-card" role="alert">
                <p>@doctorsError</p>
                <button class="btn btn-outline" @onclick="LoadDoctorsAsync">تلاش مجدد</button>
            </div>
        }
        else
        {
        <div class="patient-booking-grid">
            <label>پزشک
                <select class="admin-input" @bind="selectedDoctorId">
                    <option value="">انتخاب پزشک</option>
                    @foreach (var doctor in doctors.Where(x => x.IsActive))
                    {
                        <option value="@doctor.Id">دکتر @doctor.FirstName @doctor.LastName</option>
                    }
                </select>
            </label>
            <label>تاریخ مراجعه (شمسی)
                <input class="admin-input" @bind="jalaliDate" placeholder="۱۴۰۵/۰۹/۰۱" />
            </label>
            <label class="patient-note-field">توضیحات (اختیاری)
                <input class="admin-input" @bind="patientNote" maxlength="1000" placeholder="علت مراجعه یا توضیح کوتاه" />
            </label>
        </div>
        <div class="patient-booking-actions">
            <button class="btn btn-primary" disabled="@loadingSlots" @onclick="LoadSlotsAsync">نمایش ساعت‌های آزاد</button>
        </div>
        @if (slotsError is not null)
        {
            <div class="notice-card" role="alert">
                <p>@slotsError</p>
                <button class="btn btn-outline" @onclick="LoadSlotsAsync">تلاش مجدد</button>
            </div>
        }
        @if (slotsLoaded && slotsError is null)
        {
            @if (availableSlots.Count == 0)
            {
                <div class="empty-inline">برای این پزشک در تاریخ انتخاب‌شده ساعت آزادی وجود ندارد.</div>
            }
            else
            {
                <div class="patient-slot-grid">
                    @foreach (var slot in availableSlots)
                    {
                        <button class="patient-slot @(selectedSlot == slot ? "selected" : "")" @onclick="() => selectedSlot = slot">
                            @slot.StartTime
                        </button>
                    }
                </div>
                @if (selectedSlot is not null)
                {
                    <div class="patient-confirm-booking">
                        <span>زمان انتخابی: <strong>@selectedSlot.StartTime تا @selectedSlot.EndTime</strong></span>
                        <button class="btn btn-primary" disabled="@booking" @onclick="BookAsync">@(booking ? "در حال ایجاد درخواست..." : "ادامه و پرداخت حق‌ویزیت")</button>
                    </div>
                }
            }
        }
        @if (checkout is not null)
        {
            <div class="panel-card patient-section">
                <div class="panel-heading">
                    <div><span class="eyebrow">پرداخت حق‌ویزیت</span><h2>مبلغ قابل پرداخت: @checkout.AmountToman.ToString("N0") تومان</h2></div>
                </div>
                <p>این ساعت تا <strong>@checkout.ExpiresAtUtc.ToLocalTime().ToString("HH:mm:ss")</strong> برای شما نگه داشته شده است. لطفاً پیش از پایان مهلت واریز و رسید را ارسال کنید.</p>
                <div class="patient-booking-grid">
                    <div><small>بانک</small><strong>@(string.IsNullOrWhiteSpace(checkout.BankName) ? "اطلاعات بانکی در تنظیمات ثبت نشده" : checkout.BankName)</strong></div>
                    <div><small>صاحب حساب</small><strong>@checkout.AccountHolder</strong></div>
                    <div><small>شماره کارت</small><strong dir="ltr">@checkout.CardNumber</strong></div>
                    <div><small>شماره شبا</small><strong dir="ltr">@checkout.Iban</strong></div>
                </div>
                <label>شماره پیگیری / شرح واریز
                    <input class="admin-input" @bind="receiptReference" maxlength="100" placeholder="شماره پیگیری تراکنش" />
                </label>
                <label>تصویر رسید (JPG / PNG / WEBP، حداکثر ۱ مگابایت)
                    <InputFile OnChange="ReadReceiptAsync" accept="image/jpeg,image/png,image/webp" />
                </label>
                @if (!string.IsNullOrWhiteSpace(receiptFileName))
                {
                    <small>فایل انتخاب‌شده: @receiptFileName</small>
                }
                <div class="admin-form-actions">
                    <button class="btn btn-primary" disabled="@submittingReceipt" @onclick="SubmitReceiptAsync">@(submittingReceipt ? "در حال ارسال..." : "ارسال رسید برای بررسی")</button>
                </div>
            </div>
        }
        }
    </section>
}

@code {
    private PatientProfileDto? profile;
    private PatientAppointmentsPageDto appointments = new([], 1, 20, 0, 0);
    private List<MyAppointmentPaymentDto> myPayments = [];
    private List<AdminDoctorItem> doctors = [];
    private List<AvailableSlotItem> availableSlots = [];
    private string? selectedDoctorId;
    private string jalaliDate = "";
    private string? patientNote;
    private AvailableSlotItem? selectedSlot;
    private bool loading = true;
    private bool appointmentsLoading;
    private bool loadingSlots;
    private bool slotsLoaded;
    private bool booking;
    private bool submittingReceipt;
    private AppointmentCheckoutDto? checkout;
    private string receiptReference = "";
    private string? receiptContentType;
    private string? receiptImageBase64;
    private string? receiptFileName;
    private Guid? cancellingId;
    private bool feedbackIsError;
    private string? feedback;
    private string? profileLoadError;
    private string? appointmentsError;
    private string? doctorsError;
    private string? slotsError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        loading = true;
        profileLoadError = null;
        var result = await ApiClient.GetMyPatientProfileResultAsync();
        profile = result.Data;
        if (!result.Succeeded && !result.NotFound)
        {
            profileLoadError = result.Error ?? "خطای نامشخص هنگام دریافت پرونده بیمار.";
            loading = false;
            return;
        }

        if (profile is not null)
        {
            jalaliDate = TodayJalali();
            await LoadAppointmentsAsync();
            await LoadPaymentsAsync();
            await LoadDoctorsAsync();
        }
        loading = false;
    }

    private async Task LoadDoctorsAsync()
    {
        doctorsError = null;
        var result = await ApiClient.GetDoctorsResultAsync();
        if (!result.Succeeded || result.Data is null)
        {
            doctors = [];
            doctorsError = result.Error ?? "دریافت فهرست پزشکان ناموفق بود.";
            return;
        }
        doctors = result.Data.Where(x => x.IsActive).ToList();
    }

    private async Task LoadAppointmentsAsync()
    {
        appointmentsLoading = true;
        appointmentsError = null;
        var result = await ApiClient.GetMyAppointmentsResultAsync(appointments.Page);
        if (result.Succeeded && result.Data is not null)
            appointments = result.Data;
        else
            appointmentsError = result.Error ?? "دریافت نوبت‌های شما ناموفق بود.";
        appointmentsLoading = false;
    }

    private async Task LoadPaymentsAsync()
    {
        var result = await ApiClient.GetMyAppointmentPaymentsAsync();
        if (result.Succeeded && result.Data is not null)
            myPayments = result.Data;
    }

    private static string PaymentStatusText(string status) => status switch
    {
        "AwaitingReceipt" => "در انتظار واریز و ارسال رسید",
        "ReceiptSubmitted" => "رسید ارسال شده؛ در انتظار بررسی مدیر",
        "Approved" => "پرداخت تأیید شد؛ نوبت قطعی است",
        "Rejected" => "رسید رد شد؛ زمان نوبت آزاد شده است",
        "Expired" => "مهلت پرداخت تمام شد؛ زمان نوبت آزاد شده است",
        "Cancelled" => "درخواست توسط شما یا مرکز لغو شد",
        _ => status
    };

    private async Task ChangePageAsync(int page)
    {
        appointmentsLoading = true;
        appointmentsError = null;
        var result = await ApiClient.GetMyAppointmentsResultAsync(page);
        if (result.Succeeded && result.Data is not null)
            appointments = result.Data;
        else
            appointmentsError = result.Error ?? "دریافت نوبت‌های این صفحه ناموفق بود.";
        appointmentsLoading = false;
    }

    private async Task CancelAppointmentAsync(Guid id)
    {
        cancellingId = id;
        var result = await ApiClient.CancelMyAppointmentAsync(id);
        cancellingId = null;
        ShowFeedback(result.Message, !result.Succeeded);
        if (result.Succeeded) await LoadAppointmentsAsync();
    }

    private async Task LoadSlotsAsync()
    {
        if (!Guid.TryParse(selectedDoctorId, out var doctorId))
        {
            ShowFeedback("ابتدا پزشک را انتخاب کنید.", true);
            return;
        }
        var normalized = NormalizeDigits(jalaliDate).Replace('-', '/').Replace('.', '/');
        if (!TryParseJalali(normalized, out _))
        {
            ShowFeedback("تاریخ شمسی معتبر وارد کنید؛ نمونه: ۱۴۰۵/۰۹/۰۱", true);
            return;
        }
        loadingSlots = true;
        slotsLoaded = false;
        slotsError = null;
        selectedSlot = null;
        var result = await ApiClient.GetAvailableSlotsResultAsync(doctorId, normalized);
        if (result.Succeeded)
            availableSlots = result.Data ?? [];
        else
        {
            availableSlots = [];
            slotsError = result.Error ?? "دریافت ساعت‌های آزاد ناموفق بود.";
        }
        loadingSlots = false;
        slotsLoaded = true;
    }

    private async Task BookAsync()
    {
        if (selectedSlot is null || !Guid.TryParse(selectedDoctorId, out var doctorId)) return;
        booking = true;
        var result = await ApiClient.CreateAppointmentCheckoutAsync(doctorId, selectedSlot.StartsAtUtc, patientNote);
        booking = false;
        if (!result.Succeeded || result.Data is null)
        {
            ShowFeedback(result.Error ?? "ایجاد درخواست پرداخت ناموفق بود.", true);
            return;
        }
        checkout = result.Data;
        receiptReference = "";
        receiptContentType = null;
        receiptImageBase64 = null;
        receiptFileName = null;
        ShowFeedback("زمان نوبت برای ۱۰ دقیقه نگه داشته شد. پس از واریز، تصویر رسید را ارسال کنید.", false);
        selectedSlot = null;
        slotsLoaded = false;
    }

    private async Task ReadReceiptAsync(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file.Size > 1_048_576)
            {
                ShowFeedback("حجم تصویر رسید نباید بیشتر از یک مگابایت باشد.", true);
                return;
            }
            if (file.ContentType is not ("image/jpeg" or "image/png" or "image/webp"))
            {
                ShowFeedback("فرمت تصویر باید JPG، PNG یا WEBP باشد.", true);
                return;
            }
            await using var stream = file.OpenReadStream(1_048_576);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            receiptImageBase64 = Convert.ToBase64String(memory.ToArray());
            receiptContentType = file.ContentType;
            receiptFileName = file.Name;
        }
        catch (Exception)
        {
            ShowFeedback("خواندن تصویر رسید ناموفق بود.", true);
        }
    }

    private async Task SubmitReceiptAsync()
    {
        if (checkout is null) return;
        if (string.IsNullOrWhiteSpace(receiptReference) || string.IsNullOrWhiteSpace(receiptImageBase64) || string.IsNullOrWhiteSpace(receiptContentType))
        {
            ShowFeedback("شماره پیگیری و تصویر رسید را وارد کنید.", true);
            return;
        }
        submittingReceipt = true;
        var result = await ApiClient.SubmitAppointmentReceiptAsync(checkout.Id, receiptReference, receiptContentType, receiptImageBase64);
        submittingReceipt = false;
        ShowFeedback(result.Message, !result.Succeeded);
        if (result.Succeeded)
        {
            checkout = null;
            await LoadPaymentsAsync();
        }
    }

    private bool CanCancel(PatientAppointmentDto item) =>
        (item.Status == "Pending" || item.Status == "Confirmed") && item.StartsAtUtc > DateTimeOffset.UtcNow;

    private static string LocalizeStatus(string status) => status switch
    {
        "Pending" => "در انتظار پرداخت یا بررسی رسید",
        "Confirmed" => "تأییدشده",
        "Cancelled" => "لغوشده",
        "Completed" => "انجام‌شده",
        "NoShow" => "عدم مراجعه",
        _ => status
    };

    private static string StatusClass(string status) => status switch
    {
        "Cancelled" => "cancelled",
        "Completed" => "completed",
        _ => ""
    };

    private static string FormatBirthDate(DateOnly? value)
    {
        if (value is null) return "ثبت نشده";
        var calendar = new PersianCalendar();
        var date = value.Value.ToDateTime(TimeOnly.MinValue);
        return $"{calendar.GetYear(date):0000}/{calendar.GetMonth(date):00}/{calendar.GetDayOfMonth(date):00}";
    }

    private static string FormatTehran(DateTimeOffset value)
    {
        var zone = GetTehranZone();
        return TimeZoneInfo.ConvertTime(value, zone).ToString("HH:mm");
    }

    private static string FormatJalali(DateTimeOffset value)
    {
        var local = TimeZoneInfo.ConvertTime(value, GetTehranZone()).DateTime;
        var calendar = new PersianCalendar();
        return $"{calendar.GetYear(local):0000}/{calendar.GetMonth(local):00}/{calendar.GetDayOfMonth(local):00}";
    }

    private static string TodayJalali()
    {
        var local = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, GetTehranZone()).DateTime;
        var calendar = new PersianCalendar();
        return $"{calendar.GetYear(local):0000}/{calendar.GetMonth(local):00}/{calendar.GetDayOfMonth(local):00}";
    }

    private static TimeZoneInfo GetTehranZone()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Tehran"); }
        catch (TimeZoneNotFoundException) { return TimeZoneInfo.FindSystemTimeZoneById("Iran Standard Time"); }
    }

    private static bool TryParseJalali(string value, out DateOnly date)
    {
        date = default;
        var parts = value.Split('/');
        if (parts.Length != 3 ||
            !int.TryParse(parts[0], out var year) ||
            !int.TryParse(parts[1], out var month) ||
            !int.TryParse(parts[2], out var day)) return false;
        try
        {
            var calendar = new PersianCalendar();
            date = DateOnly.FromDateTime(calendar.ToDateTime(year, month, day, 0, 0, 0, 0));
            return true;
        }
        catch (ArgumentOutOfRangeException) { return false; }
    }

    private static string NormalizeDigits(string value) => value
        .Replace("۰", "0").Replace("۱", "1").Replace("۲", "2").Replace("۳", "3")
        .Replace("۴", "4").Replace("۵", "5").Replace("۶", "6").Replace("۷", "7")
        .Replace("۸", "8").Replace("۹", "9")
        .Replace("٠", "0").Replace("١", "1").Replace("٢", "2").Replace("٣", "3")
        .Replace("٤", "4").Replace("٥", "5").Replace("٦", "6").Replace("٧", "7")
        .Replace("٨", "8").Replace("٩", "9");

    private void ShowFeedback(string message, bool isError)
    {
        feedback = message;
        feedbackIsError = isError;
    }
}
