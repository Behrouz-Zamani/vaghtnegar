@page "/reception"
@attribute [Authorize(Roles = "Receptionist,ClinicAdmin,SuperAdmin")]
@inject VaghtNegarApiClient ApiClient
<PageTitle>پذیرش و نوبت‌ها | وقت‌نگار</PageTitle>
<section class="page-heading"><span class="eyebrow">مدیریت مراجعه‌کنندگان</span><h1>پذیرش و نوبت‌ها</h1><p class="page-lead">فهرست نوبت‌ها و وضعیت مراجعات ثبت‌شده در سامانه.</p></section>
<div class="panel-card table-panel">
    <div class="panel-heading"><div><span class="eyebrow">فهرست نوبت‌ها</span><h2>آخرین درخواست‌ها</h2></div><button class="btn btn-outline" @onclick="ReloadAsync">به‌روزرسانی</button></div>
    @if (loading)
    {
        <div class="loading-line"><span></span> در حال دریافت اطلاعات...</div>
    }
    else if (result is { Succeeded: true, Appointments.Count: > 0 })
    {
        <div class="table-wrap"><table><thead><tr><th>پزشک</th><th>بیمار</th><th>ساعت</th><th>وضعیت</th></tr></thead><tbody>
        @foreach (var item in result.Appointments)
        {
            <tr><td>@item.Doctor</td><td>@item.Patient</td><td class="time-cell">@item.Time</td><td><span class="soft-status">@item.Status</span></td></tr>
        }
        </tbody></table></div>
    }
    else
    {
        <div class="empty-inline">@((result?.Error) ?? "نوبتی برای نمایش وجود ندارد.")</div>
    }
</div>
<div class="notice-card"><strong>گام بعدی</strong><p>در مرحله بعد فیلتر تاریخ شمسی، جست‌وجوی بیمار، ثبت نوبت حضوری و عملیات تأیید یا لغو به این صفحه اضافه می‌شود.</p></div>
@code {
    private ApiCallResult? result;
    private bool loading = true;
    protected override Task OnInitializedAsync() => ReloadAsync();
    private async Task ReloadAsync()
    {
        loading = true;
        result = await ApiClient.GetAppointmentsAsync();
        loading = false;
    }
}
